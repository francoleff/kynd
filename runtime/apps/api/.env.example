# Copy to .env and adjust. NEVER commit .env.
KYND_ENVIRONMENT=development
KYND_DATABASE_URL=postgresql+psycopg://localhost/kynd_os_dev
KYND_RUNTIME_STATE_DIR=runtime_state
KYND_COOKIE_SECURE=false
KYND_CORS_ORIGINS=http://localhost:3000

# Credential encryption. Generate with:
#   python -c "from kynd_api.security.crypto import generate_key; print(generate_key())"
# Comma-separated; the FIRST key encrypts new writes, the rest decrypt old rows.
# Rotation: put the new key at the front, keep the old one until re-encrypted.
KYND_CREDENTIAL_KEYS=
