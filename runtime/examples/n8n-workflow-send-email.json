{
  "name": "Kynd - Send Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kynd-send-email",
        "responseMode": "responseNode"
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:5000/webhook/send_email",
        "method": "POST",
        "jsonParameters": true,
        "bodyParametersJson": "={\n  \"params\": {\n    \"target\": \"{{$json.target}}\",\n    \"subject\": \"{{$json.subject}}\",\n    \"body\": \"{{$json.body}}\"\n  }\n}"
      },
      "id": "kynd-execute",
      "name": "Kynd Execute",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{\n  {\n    \"status\": $json.status,\n    \"result\": $json.result,\n    \"message\": $json.status === 'ok' ? 'Email sent via Kynd governance' : $json.message\n  }\n}}"
      },
      "id": "respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Kynd Execute",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Kynd Execute": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
